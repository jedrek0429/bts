# Optional configuration loaded by scripts/bts-tmux.
# Copy to ~/.config/bts/dev.env and keep secrets out of source control.

BTS_CORE_HTTP_URL=http://127.0.0.1:3100
BTS_CORE_URL=http://127.0.0.1:3100

# For ARI bound to localhost on a remote Asterisk host, set an SSH target.
# The launcher creates a reconnecting local tunnel automatically.
# BTS_ARI_SSH_HOST=admin@192.168.1.50
# BTS_ARI_TUNNEL_PORT=18088
BTS_ARI_USERNAME=bts

# Deliberately omit BTS_ARI_PASSWORD. The telephony pane prompts without echo.
