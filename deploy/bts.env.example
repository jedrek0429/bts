# Copy to /etc/bts/bts.env and restrict it to root:bts (0640).
RUST_LOG=info

# Shared non-secret settings belong here. Component endpoints and credentials are
# stored in core.env, display.env, telephony.env and addons.env.
# The packaged Cabin font is /usr/share/fonts/TTF/impallari/Cabin-Regular.ttf;
# set BTS_CABIN_FONT in display.env only when overriding it.
