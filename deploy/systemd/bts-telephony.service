[Unit]
Description=Bansleben Telephone Services telephony bridge
Documentation=https://github.com/jedrek0429/bts
After=network-online.target asterisk.service bts-core.service
Wants=network-online.target
Requires=bts-core.service

[Service]
Type=simple
User=bts
Group=bts
EnvironmentFile=-/etc/bts/bts.env
ExecStart=/usr/bin/bts-telephony
Restart=always
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=bts.target
