[Unit]
Description=Bansleben Telephone Services telephony bridge
Documentation=https://github.com/jedrek0429/bts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bts
Group=bts
EnvironmentFile=-/etc/bts/bts.env
EnvironmentFile=-/etc/bts/telephony.env
ExecCondition=/usr/bin/sh -c '[ -f /etc/bts/telephony.env ] && grep -Eq "^BTS_ARI_PASSWORD=[^[:space:]]+$" /etc/bts/telephony.env && ! grep -Eq "^BTS_ARI_PASSWORD=CHANGE_ME$" /etc/bts/telephony.env'
ExecStart=/usr/lib/bts/components/telephony/current/bin/bts-telephony
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target bts.target bts-server.target
