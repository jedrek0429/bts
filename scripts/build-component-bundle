#!/usr/bin/env bash
set -euo pipefail

if (($# != 5)); then
    echo "Usage: build-component-bundle COMPONENT VERSION ARCH BINARY OUTPUT_DIRECTORY" >&2
    exit 2
fi

component=$1
version=${2#v}
architecture=$3
binary=$4
output_directory=$5

repository_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
"$repository_root/scripts/release-version.py" classify "$version" >/dev/null

case "$component" in
    core|display|telephony|addons) ;;
    *) echo "Unknown component: $component" >&2; exit 2 ;;
esac
case "$architecture" in
    x86_64|aarch64) ;;
    *) echo "Unsupported architecture: $architecture" >&2; exit 2 ;;
esac
[[ -x "$binary" ]] || { echo "Component binary is not executable: $binary" >&2; exit 1; }
command -v tar >/dev/null
command -v zstd >/dev/null

work_directory=$(mktemp -d)
trap 'rm -rf "$work_directory"' EXIT
bundle="$work_directory/bts-$component"
install -d "$bundle/bin" "$bundle/systemd" "$bundle/config" "$bundle/install"
install -m755 "$binary" "$bundle/bin/bts-$component"
install -m644 "$repository_root/deploy/systemd/bts-$component.service" "$bundle/systemd/"
install -m644 "$repository_root/deploy/systemd/bts.target" "$bundle/systemd/"
install -m644 "$repository_root/deploy/systemd/bts-server.target" "$bundle/systemd/"
install -m644 "$repository_root/deploy/systemd/bts-display.target" "$bundle/systemd/"
install -m644 "$repository_root/deploy/$component.env.example" "$bundle/config/"
install -m644 "$repository_root/deploy/components/$component.conf" "$bundle/install/component.conf"
install -m644 "$repository_root/LICENSE" "$bundle/LICENSE"
printf '%s\n' "$version" > "$bundle/VERSION"

install -d "$output_directory"
asset="$output_directory/bts-$component-v$version-linux-$architecture.tar.zst"
tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
    -C "$work_directory" --zstd -cf "$asset" "bts-$component"
printf '%s\n' "$asset"
