#!/usr/bin/env bash
set -euo pipefail

SESSION="${BTS_TMUX_SESSION:-bts}"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${BTS_TMUX_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/bts/dev.env}"

for command in tmux curl grep python3; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf '%s is required but was not found in PATH.\n' "$command" >&2
        exit 1
    fi
done

if [[ -r "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
fi

CORE_API_VERSION=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["core_api"])' "$ROOT/compatibility.json")
export BTS_CORE_API_PREFIX="/api/v$CORE_API_VERSION"
export BTS_CORE_HTTP_URL="${BTS_CORE_HTTP_URL:-http://127.0.0.1:3100}"
export BTS_CORE_WS_URL="${BTS_CORE_WS_URL:-ws://127.0.0.1:3100$BTS_CORE_API_PREFIX/events/ws}"
export BTS_CORE_URL="${BTS_CORE_URL:-$BTS_CORE_HTTP_URL}"
export BTS_ARI_USERNAME="${BTS_ARI_USERNAME:-bts}"
export BTS_ADDON_DATA_ROOT="${BTS_ADDON_DATA_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/bts/addons}"

if [[ -n "${BTS_ARI_SSH_HOST:-}" ]]; then
    if ! command -v ssh >/dev/null 2>&1; then
        printf 'ssh is required when BTS_ARI_SSH_HOST is configured.\n' >&2
        exit 1
    fi
    export BTS_ARI_TUNNEL_PORT="${BTS_ARI_TUNNEL_PORT:-18088}"
    export BTS_ARI_URL="http://127.0.0.1:${BTS_ARI_TUNNEL_PORT}"
else
    export BTS_ARI_URL="${BTS_ARI_URL:-http://127.0.0.1:8088}"
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    # shellcheck disable=SC2016 -- expanded by the shell inside the tmux pane.
    tmux new-session -d -s "$SESSION" -n core -c "$ROOT" \
        'RUST_LOG=${RUST_LOG:-info} cargo run -p bts-core; exec "${SHELL:-/bin/sh}"'

    for variable in BTS_CORE_API_PREFIX BTS_CORE_HTTP_URL BTS_CORE_WS_URL BTS_CORE_URL BTS_ARI_URL BTS_ARI_USERNAME BTS_ADDON_DATA_ROOT; do
        tmux set-environment -t "$SESSION" "$variable" "${!variable}"
    done
    if [[ -n "${BTS_ARI_SSH_HOST:-}" ]]; then
        tmux set-environment -t "$SESSION" BTS_ARI_SSH_HOST "$BTS_ARI_SSH_HOST"
        tmux set-environment -t "$SESSION" BTS_ARI_TUNNEL_PORT "$BTS_ARI_TUNNEL_PORT"
    fi

    # shellcheck disable=SC2016 -- expanded by the shell inside the tmux pane.
    tmux new-window -d -t "$SESSION:" -n addons -c "$ROOT" \
        'until curl -fsS "$BTS_CORE_HTTP_URL/health" >/dev/null 2>&1; do sleep 1; done; RUST_LOG=${RUST_LOG:-info} cargo run -p bts-addons; exec "${SHELL:-/bin/sh}"'

    if [[ -n "${BTS_ARI_SSH_HOST:-}" ]]; then
        # shellcheck disable=SC2016 -- expanded by the shell inside the tmux pane.
        tmux new-window -d -t "$SESSION:" -n ari-tunnel -c "$ROOT" \
            'while true; do ssh -o BatchMode=yes -o ServerAliveInterval=15 -o ExitOnForwardFailure=yes -N -L "127.0.0.1:${BTS_ARI_TUNNEL_PORT}:127.0.0.1:8088" "$BTS_ARI_SSH_HOST"; sleep 2; done'
    fi

    # shellcheck disable=SC2016 -- expanded by the shell inside the tmux pane.
    tmux new-window -d -t "$SESSION:" -n telephony -c "$ROOT" \
        'until curl -fsS "$BTS_CORE_HTTP_URL$BTS_CORE_API_PREFIX/addons" | grep -q '"'"'"menu"'"'"'; do sleep 1; done; if [[ -z "${BTS_ARI_PASSWORD:-}" ]]; then read -rsp "ARI password: " BTS_ARI_PASSWORD; printf "\n"; export BTS_ARI_PASSWORD; fi; RUST_LOG=${RUST_LOG:-info} cargo run -p bts-telephony; exec "${SHELL:-/bin/sh}"'

    tmux select-window -t "$SESSION:core"
else
    printf 'Session %s already exists; recreate it to apply configuration changes.\n' "$SESSION"
fi

printf 'BTS development session: %s\n' "$SESSION"
printf 'Attach with: tmux attach -t %q\n' "$SESSION"

if [[ "${BTS_TMUX_DETACH:-0}" != "1" ]]; then
    exec tmux attach-session -t "$SESSION"
fi
